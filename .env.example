# Copy to .env and fill in locally. Never commit .env.

# EmailJS (public keys — safe in browser)
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key

# Gemini — SERVER ONLY (local proxy + Netlify). Comma-separated, no REACT_APP_ prefix.
SIMASIA_GEMINI_API_KEYS=your_gemini_key_here

# Optional
# SIMASIA_GEMINI_MODEL=gemini-2.5-flash-lite
# SIMASIA_ALLOWED_ORIGINS=https://simasiaai.gr,https://www.simasiaai.gr
# SIMASIA_PROXY_PORT=3456
