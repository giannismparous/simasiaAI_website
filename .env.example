# Copy to .env and fill in locally. Never commit .env.

# EmailJS (public keys — safe in browser; production values from simasiaai.gr)
REACT_APP_EMAILJS_SERVICE_ID=contact_form
REACT_APP_EMAILJS_TEMPLATE_ID=template_9rrl2jt
REACT_APP_EMAILJS_PUBLIC_KEY=PVnOgkhzXh0lkxBzu

# Gemini — SERVER ONLY (local proxy + Netlify). Comma-separated, no REACT_APP_ prefix.
SIMASIA_GEMINI_API_KEYS=your_gemini_key_here

# Cheapest model only (flash-lite). Pro/ultra models are blocked server-side.
SIMASIA_GEMINI_MODEL=gemini-3.5-flash-lite
# SIMASIA_ALLOWED_ORIGINS=https://simasiaai.gr,https://www.simasiaai.gr
# SIMASIA_PROXY_PORT=3456
